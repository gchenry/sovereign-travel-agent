# Copy this file to `.env` (which is gitignored) and fill in your values:
#   cp .env.local.example .env

GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID
GOOGLE_CLOUD_LOCATION=us-central1

# Decoupled State & Memory Configuration (Injected dynamically at runtime)
MEMORYBANK_ID=projects/YOUR_PROJECT_ID/locations/us-central1/memoryBanks/mb-exec-travel-profiles
SESSION_STORE_URI=firestore://projects/YOUR_PROJECT_ID/databases/agent-session-store/collections/sessions

# Agent Role (travel-router | travel-planner | corporate-policy-agent)
AGENT_ROLE=travel-router

# Outbound Zero-Trust Agent Gateway (Local Mock Gateway or Cloud Agent Gateway)
AGENT_GATEWAY_URL=http://mock-agent-gateway:8095
AGENT_GATEWAY_RESOURCE=projects/YOUR_PROJECT_ID/locations/us-central1/agentGateways/agw-travel-secure

# Cryptographic SPIFFE Workload Identity (JWT-SVID issued by Platform Workload Identity Pool)
WORKLOAD_SPIFFE_ID=spiffe://YOUR_PROJECT_ID.svc.id.goog/ns/agent-engine/sa/travel-router-sa
PLANNER_SPIFFE_ID=spiffe://YOUR_PROJECT_ID.svc.id.goog/ns/agent-engine/sa/travel-planner-sa
POLICY_SPIFFE_ID=spiffe://YOUR_PROJECT_ID.svc.id.goog/ns/agent-engine/sa/corporate-policy-sa

# Downstream A2A & Tool Endpoints
TRAVEL_PLANNER_URL=http://travel-planner:8080
CORPORATE_POLICY_AGENT_URL=http://corporate-policy-agent:8080
MCP_SERVER_URL=http://corporate-mcp-server:8090
AIRLINE_API_URL=http://mock-airline-api:8091
